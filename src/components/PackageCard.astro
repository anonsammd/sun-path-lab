---
import { formatCurrency } from '../lib/utils';

interface Props {
  pkg: {
    id: string;
    name: string;
    slug: string;
    description: string;
    regularPrice: string | null;
    discountPrice: string | null;
    tests: string[];
    sampleType?: string | null;
    fastingRequired?: string | null;
    reportTime?: string | null;
    isFeatured?: boolean;
    imageUrl?: string | null;
  };
}

const { pkg } = Astro.props;

const testsList = Array.isArray(pkg.tests) ? pkg.tests : [];
const displayTests = testsList.slice(0, 4);
const remainingCount = testsList.length - displayTests.length;

const hasDiscount = Boolean(pkg.regularPrice && pkg.discountPrice && parseFloat(pkg.discountPrice) < parseFloat(pkg.regularPrice));
const savings = hasDiscount && pkg.regularPrice && pkg.discountPrice
  ? Math.round(((parseFloat(pkg.regularPrice) - parseFloat(pkg.discountPrice)) / parseFloat(pkg.regularPrice)) * 100)
  : 0;

const waMessage = encodeURIComponent(`Hello Sun Path Lab, I would like to book or inquire about the "${pkg.name}".`);
const waUrl = `https://wa.me/919300755303?text=${waMessage}`;
---

<article class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between overflow-hidden group">
  <div>
    <!-- Card Header / Image or Banner -->
    <div class="relative bg-slate-50 border-b border-slate-100 p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          {pkg.isFeatured && (
            <span class="inline-block bg-brand-100 text-brand-800 text-xs font-bold px-2.5 py-0.5 rounded-full mb-2 border border-brand-200">
              Popular Choice
            </span>
          )}
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-700 transition-colors leading-snug">
            <a href={`/packages/${pkg.slug}`} class="focus:outline-none">
              {pkg.name}
            </a>
          </h3>
        </div>
        {hasDiscount && (
          <span class="bg-clinical-50 text-clinical-700 text-xs font-bold px-2 py-1 rounded-md border border-clinical-200 flex-shrink-0">
            {savings}% OFF
          </span>
        )}
      </div>

      <!-- Quick Badges -->
      <div class="flex flex-wrap gap-1.5 mt-3 text-xs text-slate-600">
        {pkg.sampleType && (
          <span class="inline-flex items-center gap-1 bg-white px-2 py-0.5 rounded border border-slate-200">
            <svg class="w-3 h-3 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            {pkg.sampleType}
          </span>
        )}
        {pkg.reportTime && (
          <span class="inline-flex items-center gap-1 bg-white px-2 py-0.5 rounded border border-slate-200">
            <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {pkg.reportTime}
          </span>
        )}
      </div>
    </div>

    <!-- Tests List Preview -->
    <div class="p-5">
      <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed">
        {pkg.description}
      </p>

      {testsList.length > 0 && (
        <div class="space-y-2">
          <p class="text-xs font-bold text-slate-700 uppercase tracking-wider">
            Included Key Tests ({testsList.length}):
          </p>
          <ul class="space-y-1.5 text-xs text-slate-600">
            {displayTests.map((t) => (
              <li class="flex items-start gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="line-clamp-1">{t}</span>
              </li>
            ))}
          </ul>
          {remainingCount > 0 && (
            <p class="text-xs font-semibold text-brand-700 pt-1">
              + {remainingCount} more specialized parameters
            </p>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Card Footer: Pricing & Action Buttons -->
  <div class="p-5 pt-0 border-t border-slate-100 bg-white">
    <div class="flex items-baseline justify-between py-3">
      <div>
        <p class="text-[11px] text-slate-400 uppercase font-bold tracking-wider">Package Fee</p>
        <div class="flex items-baseline gap-2">
          {pkg.discountPrice ? (
            <>
              <span class="text-2xl font-extrabold text-slate-900 tracking-tight">
                {formatCurrency(pkg.discountPrice)}
              </span>
              {pkg.regularPrice && (
                <span class="text-sm text-slate-400 line-through">
                  {formatCurrency(pkg.regularPrice)}
                </span>
              )}
            </>
          ) : pkg.regularPrice ? (
            <span class="text-2xl font-extrabold text-slate-900 tracking-tight">
              {formatCurrency(pkg.regularPrice)}
            </span>
          ) : (
            <span class="text-base font-bold text-slate-700">
              Contact Lab
            </span>
          )}
        </div>
      </div>
      <a
        href={`/packages/${pkg.slug}`}
        class="text-xs font-semibold text-brand-700 hover:text-brand-900 underline"
      >
        View Details &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 gap-2 mt-1">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1.5 py-2.5 px-2.5 rounded-lg text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-sm cursor-pointer whitespace-nowrap min-w-0"
        aria-label={`Inquire about ${pkg.name} on WhatsApp`}
      >
        <svg class="w-3.5 h-3.5 fill-current flex-shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span class="truncate">WhatsApp</span>
      </a>
      <a
        href="tel:09300755303"
        class="inline-flex items-center justify-center gap-1.5 py-2.5 px-2.5 rounded-lg text-xs font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer whitespace-nowrap min-w-0"
        aria-label={`Call to book ${pkg.name}`}
      >
        <svg class="w-3.5 h-3.5 text-slate-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="truncate">Call Lab</span>
      </a>
    </div>
  </div>
</article>
