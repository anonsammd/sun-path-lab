---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { db } from '../../db';
import { packages, categories } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import { formatCurrency } from '../../lib/utils';
import { generatePackageSchema } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/packages', 302);
}

const rows = await db
  .select({
    package: packages,
    categoryName: categories.name,
  })
  .from(packages)
  .leftJoin(categories, eq(packages.categoryId, categories.id))
  .where(and(eq(packages.slug, slug), eq(packages.isDeleted, false), eq(packages.isPublished, true)))
  .limit(1);

if (rows.length === 0) {
  return Astro.redirect('/packages', 302);
}

const pkg = rows[0].package;
const categoryName = rows[0].categoryName || 'Diagnostic Panel';
const testsList = Array.isArray(pkg.tests) ? pkg.tests : [];

const hasDiscount = Boolean(pkg.regularPrice && pkg.discountPrice && parseFloat(pkg.discountPrice) < parseFloat(pkg.regularPrice));
const savings = hasDiscount && pkg.regularPrice && pkg.discountPrice
  ? Math.round(((parseFloat(pkg.regularPrice) - parseFloat(pkg.discountPrice)) / parseFloat(pkg.regularPrice)) * 100)
  : 0;

const waMessage = encodeURIComponent(`Hello Sun Path Lab, I would like to book or inquire about the "${pkg.name}".`);
const waUrl = `https://wa.me/919300755303?text=${waMessage}`;

const breadcrumbs = [
  { name: 'Diagnostic Packages', url: '/packages' },
  { name: pkg.name, url: `/packages/${pkg.slug}` },
];

const packageSchema = generatePackageSchema(pkg);
---

<BaseLayout
  title={pkg.seoTitle || `${pkg.name} in Jabalpur | Sun Path Lab`}
  description={pkg.seoDescription || pkg.description}
  schema={packageSchema}
>
  <div class="bg-slate-100 border-b border-slate-200">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <article class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Main Content (Left Column) -->
        <div class="lg:col-span-8 space-y-8">
          <!-- Package Header Card -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md border border-brand-200">
                {categoryName}
              </span>
              {pkg.isFeatured && (
                <span class="text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-1 rounded-md border border-amber-200">
                  ★ Popular Package
                </span>
              )}
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
              {pkg.name}
            </h1>

            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {pkg.description}
            </p>

            <!-- Key Clinical Specifications -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-100">
              <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs">
                <span class="text-slate-400 block font-semibold uppercase text-[10px]">Specimen Type</span>
                <span class="font-bold text-slate-800 mt-0.5 block">{pkg.sampleType || 'Blood Sample'}</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs">
                <span class="text-slate-400 block font-semibold uppercase text-[10px]">Fasting Instructions</span>
                <span class="font-bold text-slate-800 mt-0.5 block">{pkg.fastingRequired || 'Fasting not required'}</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs">
                <span class="text-slate-400 block font-semibold uppercase text-[10px]">Report Turnaround</span>
                <span class="font-bold text-slate-800 mt-0.5 block">{pkg.reportTime || 'Same Day'}</span>
              </div>
            </div>
          </div>

          <!-- Included Diagnostic Tests List -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <h2 class="text-lg font-bold text-slate-900">
                Included Diagnostic Parameters ({testsList.length})
              </h2>
              <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md">
                Verified Inclusions
              </span>
            </div>

            {testsList.length > 0 ? (
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                {testsList.map((test) => (
                  <li class="flex items-start gap-2.5 p-3 rounded-lg bg-slate-50 border border-slate-100 text-xs font-medium text-slate-800">
                    <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[10px] flex-shrink-0 mt-0.5">
                      ✓
                    </span>
                    <span class="leading-snug">{test}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-xs text-slate-500 py-4">
                Please contact our laboratory staff at 09300755303 for the specific component breakdown of this panel.
              </p>
            )}
          </div>

          <!-- Pre-Test Instructions & Medical Notice -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-lg font-bold text-slate-900">Patient Preparation & Instructions</h2>
            <div class="space-y-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
              <p>
                • <strong>Fasting Guidelines:</strong> If fasting is specified ({pkg.fastingRequired}), avoid food and milk for 10–12 hours prior to sample collection. Plain drinking water is permitted and encouraged.
              </p>
              <p>
                • <strong>Regular Medications:</strong> Unless specifically advised otherwise by your treating physician, continue routine medications. Inform the phlebotomist about any ongoing thyroid, blood thinner, or diabetic prescriptions.
              </p>
              <p>
                • <strong>Doorstep Home Collection:</strong> Our technician carries single-use sterile vacuum tubes to ensure zero contamination. Please ensure adequate lighting and seating at your premises.
              </p>
            </div>
          </div>
        </div>

        <!-- Sticky Sidebar Action Card (Right Column) -->
        <div class="lg:col-span-4 sticky top-24 space-y-6">
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-lg space-y-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Diagnostic Fee</p>
              <div class="flex items-baseline gap-2 mt-1">
                {pkg.discountPrice ? (
                  <>
                    <span class="text-3xl font-extrabold text-slate-900 tracking-tight">
                      {formatCurrency(pkg.discountPrice)}
                    </span>
                    {pkg.regularPrice && (
                      <span class="text-base text-slate-400 line-through">
                        {formatCurrency(pkg.regularPrice)}
                      </span>
                    )}
                    {hasDiscount && (
                      <span class="ml-auto text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                        {savings}% OFF
                      </span>
                    )}
                  </>
                ) : pkg.regularPrice ? (
                  <span class="text-3xl font-extrabold text-slate-900 tracking-tight">
                    {formatCurrency(pkg.regularPrice)}
                  </span>
                ) : (
                  <span class="text-xl font-bold text-slate-800">
                    Contact Lab for Fee
                  </span>
                )}
              </div>
            </div>

            <div class="space-y-3 pt-2">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-md cursor-pointer"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span>Book via WhatsApp</span>
              </a>

              <a
                href="tel:09300755303"
                class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>Call Lab (09300755303)</span>
              </a>
            </div>

            <div class="border-t border-slate-100 pt-4 space-y-2 text-xs text-slate-500">
              <p class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span> Doorstep home sample collection in Jabalpur
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span> ISO 9001:2015 quality assurance
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">✓</span> Direct PDF reports on WhatsApp/Email
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
