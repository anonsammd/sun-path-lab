---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db';
import { packages, categories } from '../../db/schema';
import { eq, count } from 'drizzle-orm';

export const prerender = false;

const [packagesCount, categoriesCount] = await Promise.all([
  db.select({ count: count() }).from(packages).where(eq(packages.isDeleted, false)),
  db.select({ count: count() }).from(categories),
]);
---

<AdminLayout title="Database Backup & Data Export" activeTab="export">
  <div class="max-w-4xl mx-auto space-y-6">
    <div>
      <h2 class="text-xl font-bold text-slate-900">Database Export & Backup Tools</h2>
      <p class="text-sm text-slate-500 mt-1">
        Export your diagnostic packages, pricing records, and site configuration for local safety.
      </p>
    </div>

    <!-- Export Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Complete JSON Backup -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="p-2 bg-brand-50 text-brand-600 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </span>
            <h3 class="text-base font-bold text-slate-900">Full Content Backup (JSON)</h3>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Includes all active diagnostic packages, categories, business contact info, opening hours, and CMS copy in structured JSON format.
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-600">
            <p>• {packagesCount[0]?.count || 0} Diagnostic Packages</p>
            <p>• {categoriesCount[0]?.count || 0} Categories</p>
            <p>• Full Site Settings & Hero Metadata</p>
          </div>
        </div>

        <div class="mt-6">
          <a
            href="/api/export?format=json"
            download
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-lg shadow-sm transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download JSON Snapshot</span>
          </a>
        </div>
      </div>

      <!-- Packages CSV Export -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="p-2 bg-emerald-50 text-emerald-600 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </span>
            <h3 class="text-base font-bold text-slate-900">Packages Spreadsheet (CSV)</h3>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Exports a spreadsheet of diagnostic packages, current prices, discount fees, test counts, and publication statuses. Can be opened in Excel or Google Sheets.
          </p>
          <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-600">
            <p>• Clean tabular format</p>
            <p>• Compatible with Microsoft Excel & Google Sheets</p>
            <p>• Ideal for offline price audits</p>
          </div>
        </div>

        <div class="mt-6">
          <a
            href="/api/export?format=csv"
            download
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-lg shadow-sm transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Export CSV Spreadsheet</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Safety & Disaster Recovery Guidance -->
    <div class="bg-amber-50 rounded-xl border border-amber-200 p-6 text-xs text-amber-900 space-y-2">
      <h4 class="font-bold text-sm text-amber-950 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Important Note on Database Backups
      </h4>
      <p class="leading-relaxed">
        Exporting data through this dashboard produces a structured application-level export of your active diagnostic packages and website copy. It is ideal for records, spreadsheets, and disaster recovery.
      </p>
      <p class="leading-relaxed">
        For complete point-in-time database restoration including migration sequences and raw byte storage, Neon PostgreSQL automatically provides continuous automated backups and branching directly in your Neon console.
      </p>
    </div>
  </div>
</AdminLayout>
