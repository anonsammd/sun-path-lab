---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db';
import { mediaAssets } from '../../db/schema';
import { desc } from 'drizzle-orm';
import { isCloudinaryConfigured } from '../../lib/cloudinary';

export const prerender = false;

const assets = await db.select().from(mediaAssets).orderBy(desc(mediaAssets.createdAt));
const cloudinaryConfigured = isCloudinaryConfigured();
---

<AdminLayout title="Image Management" activeTab="media">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900">Image Asset Library</h2>
        <p class="text-sm text-slate-500 mt-1">
          Upload and manage photos for packages, equipment, and laboratory sections via Cloudinary.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class={`text-xs px-2.5 py-1 rounded-full font-bold border ${cloudinaryConfigured ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`}>
          {cloudinaryConfigured ? '✓ Cloudinary Configured' : '⚠️ Cloudinary Missing Keys'}
        </span>
      </div>
    </div>

    <!-- Upload Card -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-3">
        Upload New Image Asset
      </h3>

      <div id="upload-alert" class="hidden p-4 rounded-lg text-sm font-medium mb-4"></div>

      <div class="flex flex-col sm:flex-row items-center gap-4">
        <input
          type="file"
          id="file-input"
          accept="image/png,image/jpeg,image/webp,image/svg+xml"
          class="text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer"
        />
        <input
          type="text"
          id="alt-text-input"
          placeholder="Alt description for SEO (e.g. Reception desk at Russell Chowk)"
          class="w-full sm:w-80 px-3.5 py-2 text-xs rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500"
        />
        <button
          type="button"
          id="upload-btn"
          class="w-full sm:w-auto px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-lg shadow-sm transition-colors cursor-pointer flex-shrink-0"
        >
          Upload to Cloudinary
        </button>
      </div>
      <p class="text-[11px] text-slate-400 mt-2">
        Allowed formats: WEBP, JPEG, PNG, SVG. Max file size: 5MB. Uploads are securely signed on the server.
      </p>
    </div>

    <!-- Assets Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {assets.map((asset) => {
        const isLocal = asset.publicId.startsWith('local:');
        return (
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between group">
            <div class="relative bg-slate-100 aspect-video flex items-center justify-center overflow-hidden">
              <img
                src={asset.url}
                alt={asset.altText || 'Media asset'}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class={`absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded shadow-sm ${isLocal ? 'bg-slate-900/80 text-white' : 'bg-emerald-900/80 text-white'}`}>
                {isLocal ? 'Verified Local' : 'Cloudinary'}
              </span>
            </div>

            <div class="p-4 space-y-2">
              <p class="text-xs font-bold text-slate-900 truncate" title={asset.altText || asset.url}>
                {asset.altText || 'Image Asset'}
              </p>
              <p class="text-[11px] font-mono text-slate-400 truncate" title={asset.url}>
                {asset.url}
              </p>

              <div class="pt-2 flex items-center justify-between border-t border-slate-100">
                <button
                  type="button"
                  class="copy-url-btn text-xs font-semibold text-brand-700 hover:text-brand-900 cursor-pointer flex items-center gap-1"
                  data-url={asset.url}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                  </svg>
                  <span>Copy URL</span>
                </button>

                {!isLocal && (
                  <button
                    type="button"
                    class="delete-asset-btn text-xs font-semibold text-red-600 hover:text-red-800 cursor-pointer"
                    data-id={asset.id}
                    data-public-id={asset.publicId}
                  >
                    Delete
                  </button>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script is:inline>
    const csrfToken = document.getElementById('csrf-meta')?.dataset.csrfToken || '';
    const fileInput = document.getElementById('file-input');
    const altInput = document.getElementById('alt-text-input');
    const uploadBtn = document.getElementById('upload-btn');
    const alertBox = document.getElementById('upload-alert');

    // Copy URL handler
    document.querySelectorAll('.copy-url-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.url;
        navigator.clipboard.writeText(url);
        const span = btn.querySelector('span');
        const oldText = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => {
          span.textContent = oldText;
        }, 1500);
      });
    });

    // Upload to Cloudinary using signed upload parameters
    uploadBtn?.addEventListener('click', async () => {
      const file = fileInput.files?.[0];
      if (!file) {
        alert('Please choose an image file first.');
        return;
      }

      uploadBtn.disabled = true;
      uploadBtn.textContent = 'Preparing upload...';
      alertBox.className = 'hidden';

      try {
        // 1. Get signed signature from server
        const signRes = await fetch('/api/media/sign', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken,
          },
          body: JSON.stringify({ folder: 'sunpathlab' }),
        });

        const signData = await signRes.json();
        if (!signRes.ok) throw new Error(signData.error || 'Signing failed');

        uploadBtn.textContent = 'Uploading to Cloudinary...';

        // 2. Direct client upload to Cloudinary
        const formData = new FormData();
        formData.append('file', file);
        formData.append('api_key', signData.apiKey);
        formData.append('timestamp', signData.timestamp);
        formData.append('signature', signData.signature);
        formData.append('folder', signData.folder);

        const cloudinaryUploadUrl = `https://api.cloudinary.com/v1_1/${signData.cloudName}/image/upload`;
        const cloudRes = await fetch(cloudinaryUploadUrl, {
          method: 'POST',
          body: formData,
        });

        const cloudData = await cloudRes.json();
        if (!cloudRes.ok) throw new Error(cloudData.error?.message || 'Cloudinary upload failed');

        uploadBtn.textContent = 'Registering asset in PostgreSQL...';

        // 3. Register asset in PostgreSQL
        const regRes = await fetch('/api/media', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken,
          },
          body: JSON.stringify({
            url: cloudData.secure_url,
            publicId: cloudData.public_id,
            format: cloudData.format,
            width: cloudData.width,
            height: cloudData.height,
            bytes: cloudData.bytes,
            altText: altInput.value.trim() || file.name,
          }),
        });

        if (!regRes.ok) throw new Error('Failed to save asset in database');

        alertBox.className = 'p-4 rounded-lg text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200 block mb-4';
        alertBox.textContent = 'Image uploaded and registered successfully!';

        setTimeout(() => {
          window.location.reload();
        }, 600);
      } catch (err) {
        alertBox.className = 'p-4 rounded-lg text-sm font-medium bg-red-50 text-red-800 border border-red-200 block mb-4';
        alertBox.textContent = err.message || 'Upload error';
        uploadBtn.disabled = false;
        uploadBtn.textContent = 'Upload to Cloudinary';
      }
    });

    // Delete asset handler
    document.querySelectorAll('.delete-asset-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const publicId = btn.dataset.publicId;

        if (!confirm('Are you sure you want to delete this image? If it is used by any active package, deletion will be blocked.')) {
          return;
        }

        try {
          const res = await fetch('/api/media', {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
              'x-csrf-token': csrfToken,
            },
            body: JSON.stringify({ id, publicId }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to delete asset');

          window.location.reload();
        } catch (err) {
          alert('Delete error: ' + err.message);
        }
      });
    });
  </script>
</AdminLayout>
