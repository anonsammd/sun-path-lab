# Neon PostgreSQL Connection URLs
# Serverless pooled connection for application queries
DATABASE_POOL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection for migrations and Drizzle kit
DIRECT_DATABASE_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Optional fallback standard alias
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Custom Session Encryption Secret (32+ chars random string)
SESSION_SECRET="your-secure-random-32-char-session-secret-here"

# Cloudinary Media Management
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_SECRET_KEY="your_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Public Site URL
SITE_URL="https://sunpathlab.com"
